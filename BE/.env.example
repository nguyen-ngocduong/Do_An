# Sao chép thành BE/.env và đặt mật khẩu riêng trước khi chạy.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PAUSE_SECONDS=4
HOST=127.0.0.1
PORT=8000
# Khi mở truy cập LAN, dùng HTTPS và đặt cả hai đường dẫn chứng chỉ.
SSL_CERTFILE=
SSL_KEYFILE=
# Có thể ghi đè nếu artifact hoặc dữ liệu chạy được đặt ở nơi khác.
# XGB_DIR=/absolute/path/to/xgb_meta_20261021_092334_9024562d
# SHAP_DIR=/absolute/path/to/shap_20261022_021654_2555e479
# INTEGRATION_DIR=/absolute/path/to/integration_20261022_075217_0b67d48f
# RUNTIME_DIR=/absolute/path/to/runtime
