!output/xai_shap_runs/shap_20261022_021654_2555e479/golden_predictions.csv
!output/integration_runs/integration_20261022_075217_0b67d48f/output_checksums.json
!output/integration_runs/integration_20261022_075217_0b67d48f/protocol.json
!output/integration_runs/integration_20261022_075217_0b67d48f/input_schema.json
!output/integration_runs/integration_20261022_075217_0b67d48f/system_prompt.txt
