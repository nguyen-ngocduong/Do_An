# Sao chép thành .env, điền cấu hình riêng; không commit hoặc đưa .env vào image.
# Tag của cả ba image, phải khớp phiên bản trong archive đã docker load.
NIDR_VERSION=1.0.0
# Cổng trình duyệt trên máy cá nhân; mặc định http://localhost:8080.
NIDR_PORT=8080
# Tài khoản đăng nhập NIDR trên máy này; ADMIN_PASSWORD bắt buộc phải đặt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Chỉ cần key khi gọi Gemini. Để trống vẫn chạy được dự đoán và SHAP.
# Giá trị chứa dấu $ nên đặt trong nháy đơn để Compose không nội suy.
# Không dùng NEXT_PUBLIC_* cho các bí mật này vì chúng chỉ dành cho BE.
GEMINI_API_KEY=
# ID model Gemini dùng cho diễn giải; cần được API key của bạn hỗ trợ.
GEMINI_MODEL=gemini-3.5-flash-lite
# Chỉ cho VPS: đường dẫn thư mục chứa server.crt/server.key của domain.
# NIDR_TLS_DIR=/absolute/path/to/tls
