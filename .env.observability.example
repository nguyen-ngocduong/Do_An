# Sao chép thành .env.observability; file thật được Git/Docker build context bỏ qua.
# Dùng cùng BE/.env: --env-file BE/.env --env-file .env.observability
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# true gửi prompt bằng chứng SHAP và câu trả lời Gemini, không gửi CSV đầy đủ/label.
LANGFUSE_CAPTURE_CONTENT=true

# Một broker, một partition; chỉ truy cập bên trong mạng Docker.
KAFKA_TOPIC=nidr.csv.rows.v1
KAFKA_GROUP_ID=nidr-predict-v1
CSV_ROWS_PER_SECOND=50
# batch hoặc replay. Replay giữ nhịp hiển thị theo dòng của NIDR.
KAFKA_RUN_MODE=batch
KAFKA_REPLAY_INTERVAL=0.05
# Mount chỉ đọc; producer chỉ chọn nidr_test_*.csv, không chọn manifest.csv.
NIDR_UPLOAD_DIR=./upload
# Dashboard local. Không mở cổng này ra Internet.
# Cổng Netdata cố định 19999, chỉnh bind to trong deploy/observability/netdata.conf nếu cần.
